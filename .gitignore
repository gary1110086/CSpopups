# Publish only the website. Local originals, archives and agent notes stay local.
*
!/.gitignore
!/.gitattributes
!/.nojekyll
!/README.md
!/index.html
!/article.html
!/story.html
!/offer.html
!/nightroom.html
!/cornhub.html
!/redirect.html
!/about.html
!/404.html
!/site.js
!/site.css
!/content.js
!/styles.css
!/nightroom.js
!/nightroom.css
!/assets/
/assets/*
!/assets/favicon.svg
!/assets/cornhub-favicon.svg
!/assets/sunday-room.png
!/assets/earbuds.png
!/assets/mobile-plan.png
!/assets/nightroom-contact-sheet.png

# Independent Stillwall wallpaper experience.
!/wallpapers/
!/wallpapers/*.html
!/wallpapers/*.js
!/wallpapers/*.css
!/wallpapers/*.svg
!/wallpapers/README.md
!/wallpapers/assets/
!/wallpapers/assets/*.svg
!/wallpapers/vendor/
!/wallpapers/vendor/*.js
!/wallpapers/vendor/*.css
!/wallpapers/vendor/assets/
!/wallpapers/vendor/assets/*.png
!/wallpapers/vendor/assets/*.svg

# Independent randomized task websites and advertiser destinations.
!/browse/
!/browse/*.html
!/browse/*.js
!/browse/*.css
!/browse/*.json
!/browse/*.md
!/browse/assets/
!/browse/assets/*.png
!/browse/assets/*.svg
!/browse/assets/*.md
