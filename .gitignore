# Publish only the website. Local originals, archives and agent notes stay local.
*
!/.gitignore
!/.gitattributes
!/.nojekyll
!/README.md
!/README.zh-CN.md
!/index.html
!/article.html
!/story.html
!/offer.html
!/nightroom.html
!/cornhub.html
!/redirect.html
!/about.html
!/404.html
!/assets/
/assets/*
!/assets/favicon.svg
!/assets/readme-preview.png
!/assets/README-PREVIEW.md
!/assets/cornhub-favicon.svg
!/assets/sunday-room.png
!/assets/earbuds.png
!/assets/mobile-plan.png
!/assets/nightroom-contact-sheet.png

# Independent Stillwall wallpaper experience.
!/wallpapers/
!/wallpapers/*.html
!/wallpapers/*.js
!/wallpapers/*.css
!/wallpapers/*.svg
!/wallpapers/README.md
!/wallpapers/assets/
!/wallpapers/assets/*.svg
!/wallpapers/vendor/
!/wallpapers/vendor/*.js
!/wallpapers/vendor/*.css
!/wallpapers/vendor/assets/
!/wallpapers/vendor/assets/*.png
!/wallpapers/vendor/assets/*.svg

# Independent randomized task websites and advertiser destinations.
!/browse/
!/browse/*.html
!/browse/*.js
!/browse/*.css
!/browse/*.json
!/browse/*.md
!/browse/preview-server.py
!/browse/assets/
!/browse/assets/*.png
!/browse/assets/*.jpg
!/browse/assets/*.webp
!/browse/assets/*.svg
!/browse/assets/*.md
!/browse/assets/*.mp4
!/browse/assets/*.vtt
!/browse/assets/*.mp3
!/browse/assets/*.json

# Project documentation and the earlier article-site runtime.
!/docs/
!/docs/*.md
!/prototypes/
!/prototypes/little-daily/
!/prototypes/little-daily/*.js
!/prototypes/little-daily/*.css
!/prototypes/little-daily/README.md
