# Publish only the website. Local originals, archives and agent notes stay local.
*
!/.gitignore
!/.gitattributes
!/.nojekyll
!/README.md
!/README.zh-CN.md
!/index.html
!/article.html
!/story.html
!/offer.html
!/nightroom.html
!/cornhub.html
!/redirect.html
!/about.html
!/404.html
!/assets/
/assets/*
!/assets/favicon.svg
!/assets/nightroom-contact-sheet.png

# Shared wallpaper catalogue/artwork and retired-route compatibility redirects.
!/wallpapers/
!/wallpapers/*.html
!/wallpapers/catalog.js
!/wallpapers/README.md
!/wallpapers/assets/
!/wallpapers/assets/*.svg


# Independent randomized task websites and advertiser destinations.
!/browse/
!/browse/*.html
!/browse/*.js
!/browse/*.css
!/browse/*.json
!/browse/*.md
!/browse/preview-server.py
!/browse/assets/
!/browse/assets/*.png
!/browse/assets/*.jpg
!/browse/assets/*.webp
!/browse/assets/*.svg
!/browse/assets/*.md
!/browse/assets/*.mp4
!/browse/assets/*.vtt
!/browse/assets/*.mp3
!/browse/assets/*.json

# Current timed-round endings (original volume shader and generated voice).
!/browse/end-effects/
!/browse/end-effects/*.html
!/browse/end-effects/*.js
!/browse/end-effects/*.css
!/browse/end-effects/*.wav
!/browse/end-effects/*.mp3

# Project documentation.
!/docs/
!/docs/*.md
!/docs/history/
!/docs/history/*.md
!/docs/images/
!/docs/images/*.md
!/docs/images/*.png
!/docs/images/history/
!/docs/images/history/*.md
!/docs/images/history/*.png


# Local archives, working notes and verification evidence.
/archives/
/local/
